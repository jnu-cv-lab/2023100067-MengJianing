#!/usr/bin/env python3
import os
import cv2
import numpy as np
import glob

# ======================== 配置区 ========================
IMAGE_FOLDER = "/home/fntq/cv-course/.venv-dl/1/image/picture(1)/picture"
IMAGE_EXTENSION = "*.jpg"
CORNER_SAVE_DIR = "/home/fntq/cv-course/.venv-dl/1/image/corner_result"
UNDISTORT_COMPARE = "/home/fntq/cv-course/.venv-dl/1/image/undistort_compare.jpg"
PARAM_SAVE_PATH = "/home/fntq/cv-course/.venv-dl/1/image/camera_params.npz"

BOARD_SIZE = (9, 6)
SQUARE_SIZE = 25.0
MIN_VALID_PIC = 10
SHOW_WINDOW = False
# ========================================================

if not os.path.exists(CORNER_SAVE_DIR):
    os.makedirs(CORNER_SAVE_DIR)
if not os.path.exists(IMAGE_FOLDER):
    raise FileNotFoundError("标定图片路径不存在")

# 棋盘三维世界坐标 Z=0
obj_template = np.zeros((BOARD_SIZE[0] * BOARD_SIZE[1], 3), np.float32)
obj_template[:, :2] = np.mgrid[0:BOARD_SIZE[0], 0:BOARD_SIZE[1]].T.reshape(-1, 2)
obj_template *= SQUARE_SIZE

all_obj = []
all_img = []
img_list = glob.glob(os.path.join(IMAGE_FOLDER, IMAGE_EXTENSION))
img_list.sort()
valid_count = 0
demo_img_path = ""

print(f"共读取 {len(img_list)} 张标定图，开始预处理+角点检测")

for img_path in img_list:
    img = cv2.imread(img_path)
    if img is None:
        print(f"跳过损坏图：{os.path.basename(img_path)}")
        continue
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    gray = cv2.GaussianBlur(gray, (3, 3), 0)
    clahe = cv2.createCLAHE(clipLimit=3.0, tileGridSize=(8, 8))
    gray = clahe.apply(gray)

    flags = cv2.CALIB_CB_ADAPTIVE_THRESH + cv2.CALIB_CB_FAST_CHECK + cv2.CALIB_CB_NORMALIZE_IMAGE
    ret, corners = cv2.findChessboardCorners(gray, BOARD_SIZE, flags=flags)

    if ret:
        sub_criteria = (cv2.TERM_CRITERIA_EPS + cv2.TERM_CRITERIA_MAX_ITER, 50, 0.0001)
        corners_sub = cv2.cornerSubPix(gray, corners, (15, 15), (-1, -1), sub_criteria)

        all_obj.append(obj_template)
        all_img.append(corners_sub)
        valid_count += 1

        draw_img = img.copy()
        cv2.drawChessboardCorners(draw_img, BOARD_SIZE, corners_sub, ret)

        # 背景去除：仅棋盘保留，其余涂黑
        pts = corners_sub.reshape(-1, 2).astype(np.int32)
        x_min, y_min = np.min(pts, axis=0)
        x_max, y_max = np.max(pts, axis=0)
        mask = np.zeros_like(draw_img)
        mask[y_min:y_max, x_min:x_max] = 255
        draw_img = cv2.bitwise_and(draw_img, mask)

        save_name = os.path.join(CORNER_SAVE_DIR, f"corner_{os.path.basename(img_path)}")
        cv2.imwrite(save_name, draw_img)

        if valid_count == 1:
            demo_img_path = img_path
        print(f"✅ 识别成功：{os.path.basename(img_path)}")
    else:
        print(f"❌ 识别失败：{os.path.basename(img_path)}")

print(f"\n有效标定图片：{valid_count} 张")
if valid_count < MIN_VALID_PIC:
    raise RuntimeError(f"有效图片不足{MIN_VALID_PIC}张，无法完成标定")

# 相机标定求解
img_h, img_w = gray.shape
K = np.zeros((3, 3))
D = np.zeros((5, 1))
rvecs, tvecs = [], []
total_err, K, D, rvecs, tvecs = cv2.calibrateCamera(all_obj, all_img, (img_w, img_h), K, D)
avg_err = total_err / len(all_obj)

# 核心修复：缩放系数 alpha=0，完整保留画面像素，无大面积黑边
demo_origin = cv2.imread(demo_img_path)
# alpha=0 矫正后不裁切画面，不会出现环形空洞
new_K, roi = cv2.getOptimalNewCameraMatrix(K, D, (img_w, img_h), alpha=0, newImgSize=(img_w, img_h))
demo_undist = cv2.undistort(demo_origin, K, D, None, new_K)

# 左右拼接：原图 | 完整无裁切去畸变图
compare = np.hstack([demo_origin, demo_undist])
cv2.imwrite(UNDISTORT_COMPARE, compare)

# 保存标定参数
np.savez(PARAM_SAVE_PATH, cameraMatrix=K, distCoeffs=D, rvecs=rvecs, tvecs=tvecs, avg_error=avg_err)

# 控制台输出报告数据
print("\n==================== 标定结果 ====================")
print(f"棋盘：{BOARD_SIZE[0]}×{BOARD_SIZE[1]} 内角点，方格 {SQUARE_SIZE} mm")
print(f"分辨率：{img_w} × {img_h}")
print(f"平均重投影误差：{avg_err:.4f} 像素")
print("内参矩阵 K：")
print(K)
print("畸变系数 [k1,k2,p1,p2,k3]：")
print(D.flatten())
print("==================================================")
print(f"角点图输出目录：{CORNER_SAVE_DIR}")
print(f"原图-去畸变对比图：{UNDISTORT_COMPARE}")

if SHOW_WINDOW:
    cv2.imshow("Compare", compare)
    cv2.waitKey(0)
    cv2.destroyAllWindows()